{
    "name": "vheins/laravel-module-generator",
    "description": "Generate Laravel Modules from a template.",
    "type": "laravel-module",
    "authors": [
        {
            "name": "Muhammad Rheza Alfin",
            "email": "m.rheza.alfin@gmail.com"
        }
    ],
    "keywords": [
        "Laravel",
        "Laravel Modules",
        "Generator"
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "lorisleiva/laravel-actions": "^v2.7.1",
        "symfony/yaml": "^7.4 || ^8.0",
        "nwidart/laravel-modules": "^v10.0 || ^v11.0 || ^v12.0 || ^v13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^12.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.6"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vheins\\LaravelModuleGenerator\\Providers\\LaravelModuleGeneratorServiceProvider"
            ],
            "aliases": {
                "ModuleGenerator": "Vheins\\LaravelModuleGenerator\\Facades\\LaravelModuleGenerator",
                "LaravelModuleGenerator": "Vheins\\LaravelModuleGenerator\\Facades\\LaravelModuleGenerator"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Vheins\\LaravelModuleGenerator\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true,
            "pestphp/pest-plugin": true,
            "nunomaduro/collision": true,
            "nunomaduro/termwind": true,
            "laravel/pint": true,
            "orchestra/sidekick": true,
            "orchestra/canvas-core": true
        }
    }
}
